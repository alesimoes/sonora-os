@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

<urn:sonora:test#crash>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Sonora test: crash" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0> ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "crash" ; lv2:name "Crash" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled
    ] , [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out" ; lv2:name "Out"
    ] .

<urn:sonora:test#sleep>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Sonora test: sleep" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0> ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "sleep_ms" ; lv2:name "Sleep (ms)" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1000.0
    ] , [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out" ; lv2:name "Out"
    ] .

<urn:sonora:test#liar>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Sonora test: liar (declares 2 channels, writes 8)" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0> ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
    ] , [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] .

<urn:sonora:test#nan>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Sonora test: NaN and Inf on demand" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0> ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "nan" ; lv2:name "NaN" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ; lv2:portProperty lv2:toggled
    ] , [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out" ; lv2:name "Out"
    ] .

<urn:sonora:test#key>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Sonora test: outputs its key, then writes over it" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0> ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "key" ; lv2:name "Key" ;
        lv2:portProperty lv2:isSideChain
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out" ; lv2:name "Out"
    ] .

<urn:sonora:test#keyliar>
    a lv2:Plugin, lv2:UtilityPlugin ;
    doap:name "Sonora test: writes past its key input" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0> ;
    lv2:port [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "key" ; lv2:name "Key" ;
        lv2:portProperty lv2:isSideChain
    ] , [
        a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out" ; lv2:name "Out"
    ] .
