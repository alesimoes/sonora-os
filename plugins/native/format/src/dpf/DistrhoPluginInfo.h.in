// DPF reads a plugin's static description from these macros
// (third_party/dpf/distrho/DistrhoPluginInfo.h.template documents them).
#pragma once

// Our names only (ADR-0011 §5). No DISTRHO_PLUGIN_BRAND: DPF uses it only
// to write MOD Devices' mod:brand and mod:label into the TTL, a hardware
// maker's vocabulary we keep out of our metadata (third_party/dpf/SONORA.md,
// patch 4). The maker shown to hosts is getMaker() (plugin.cpp).
#define DISTRHO_PLUGIN_NAME "@SONORA_DISPLAY_NAME@"
#define DISTRHO_PLUGIN_URI "@SONORA_LV2_URI@"
// The VST3 class ID is "DPF " "clas" <unique id> <brand id>: these two are
// what make it ours and stable. Never change one: it is the identity a
// saved session finds the plugin by.
#define DISTRHO_PLUGIN_BRAND_ID Snra
#define SONORA_PLUGIN_UNIQUE_ID "@SONORA_UID@"

// The editor is the Sonora UI's own panel, built from the descriptor
// (ADR-0011 §2.6): the binaries carry no editor code.
#define DISTRHO_PLUGIN_HAS_UI 0
#define DISTRHO_PLUGIN_IS_RT_SAFE 1
// The layout is fixed per bundle: 2 in and 2 out (stereo) or 1 and 1
// (mono), each a bundle of its own with its own URI and class ID, because
// DPF fixes the port count at compile time. A processor that takes a key
// (compressor, gate) has that many side-chain inputs after the main ones,
// marked as such (plugin.cpp): lv2:isSideChain in LV2, an aux bus in VST3.
#define SONORA_CHANNELS @SONORA_CHANNELS@
#define SONORA_SIDECHAIN_CHANNELS @SONORA_SIDECHAIN_CHANNELS@
#define DISTRHO_PLUGIN_NUM_INPUTS (SONORA_CHANNELS + SONORA_SIDECHAIN_CHANNELS)
#define DISTRHO_PLUGIN_NUM_OUTPUTS SONORA_CHANNELS
#define DISTRHO_PLUGIN_WANT_LATENCY 1
// Only processors that follow a host tempo ask for the transport.
#define DISTRHO_PLUGIN_WANT_TIMEPOS @SONORA_TIMEPOS@

#define DISTRHO_PLUGIN_LV2_CATEGORY "@SONORA_LV2_CATEGORY@"
#define DISTRHO_PLUGIN_VST3_CATEGORIES "@SONORA_VST3_CATEGORIES@"
