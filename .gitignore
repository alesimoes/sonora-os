# Build output
build/
build-container/
# The Qt interface, built by tools/build-ui.sh in the sonora-ui image.
build-ui-container/
# The sanitizer builds, named as in .github/workflows/ci.yml.
build-tsan/
build-asan/
# Kernel, initrd and serial logs extracted by the QEMU boot test.
build-qemu/
# Disk images, kernel and serial logs from the USB writer test.
build-usb/
# Session, logs and reader output from the BWF interop test.
build-interop/
*.o
*.a
compile_commands.json

# The engine binary is staged into the image by tools/build-iso.sh. It is a
# build artefact, not source.
iso/config/includes.chroot/usr/local/bin/sonora-engine

# `lb config` writes its own defaults into iso/config on every run: its stock
# hooks, package lists and a dozen stage directories. Only the files we author
# are tracked, so the generated siblings are ignored by name rather than by
# cleaning up after each build.
iso/config/binary
iso/config/bootstrap
iso/config/chroot
iso/config/common
iso/config/source
iso/config/apt
iso/config/archives
# Our bootloader overrides are tracked; anything else lb puts there is not.
iso/config/bootloaders/*
!iso/config/bootloaders/isolinux/
!iso/config/bootloaders/grub-pc/
iso/config/debian-installer/
iso/config/includes/
iso/config/includes.binary/
iso/config/includes.bootstrap/
iso/config/includes.installer/
iso/config/includes.source/
iso/config/includes.chroot_after_packages/
iso/config/includes.chroot_before_packages/
iso/config/packages/
iso/config/packages.binary/
iso/config/packages.chroot/
iso/config/preseed/
iso/config/rootfs/
iso/config/hooks/live/
iso/config/package-lists/live.list.chroot
# Stock live-build hooks are numbered 1000 and above; ours is 0100.
iso/config/hooks/normal/[1-9][0-9][0-9][0-9]-*

# live-build artefacts. The cache is large and the chroot is machine-specific.
iso/.build/
iso/cache/
iso/chroot/
iso/binary/
iso/local/
iso/*.iso
iso/*.log
iso/*.contents
iso/*.files
iso/*.packages
iso/chroot.files

# Recorded audio must never be committed.
*.wav
*.aiff
*.flac
Sessions/

# Python bytecode. tools/verify-recording.py gets imported by hand sometimes,
# which leaves a __pycache__ behind.
__pycache__/
*.pyc

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Agent worktrees, one per parallel squad (ADR-0007).
/.claude/worktrees/

# The coordinating session's handoff is the coordinator's local file. When
# every PR rewrote it, each merge forced a conflicting rebase of every queued
# PR. tools/session-start.sh still prints it when it exists.
/planning/handoffs/main-session.md
