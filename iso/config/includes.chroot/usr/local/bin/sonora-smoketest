#!/bin/sh
# Boot smoke test. Runs only when the kernel command line asks for it and
# prints one line per check to the console. sonora-smoketest.service powers the
# machine off when this exits (SuccessAction=/FailureAction=); a poweroff of
# our own would race the unit's and is not here.
#
# Every check here corresponds to a defect that actually happened. The ones
# worth understanding:
#
#   - The kernel check exists because an image once installed the RT kernel
#     and booted the generic one. It booted, it recorded, nothing complained.
#
#   - The restart check exists because sonora-session.service is
#     Restart=always. An engine that starts, runs two seconds and dies is
#     "active" most of the time, so sampling pgrep once would call that a pass.
#     Restart=always is there to protect the operator, not to hide failure
#     from the test.
#
#   - The capture-port check exists because the whole point of the Pro Audio
#     profile is channel count, and a count that is merely logged is a count
#     nobody is checking.

FAILED=0

check() {
  name="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    echo "SMOKETEST ok    $name"
  else
    echo "SMOKETEST FAIL  $name"
    FAILED=1
  fi
}

fail() {
  echo "SMOKETEST FAIL  $1"
  FAILED=1
}

# How many capture ports we insist on. Overridable from the kernel command
# line, so the same image can be asserted against a real interface:
#   sonora.expect_capture=18
EXPECT_CAPTURE=1
# sonora.gui: the display stack runs on tty1 and the session stands down.
# sonora.expect_fallback: the harness broke the UI on purpose, so the display
# fallback must have handed tty1 back to the session (ADR-0010 stage 1).
# sonora.break_ui: this script breaks the UI itself, then expects the fallback
# (ADR-0010 stage 1: an injected repeated UI failure ends on tty1 with the
# session). It implies sonora.gui and sonora.expect_fallback.
GUI=0
EXPECT_FALLBACK=0
BREAK_UI=0
# sonora.virtualcard: load snd-dummy (26 capture channels) and record from it.
VIRTUALCARD=0
# sonora.expect_installed: this boot is an installed system (ADR-0032), so
# it must be running from its own disk. sonora.expect_file=PATH with
# sonora.expect_sha=SHA256: a session file carried over from the stick must be
# there, byte for byte.
EXPECT_INSTALLED=0
EXPECT_FILE=
EXPECT_SHA=
# sonora.policycheck: assert the running mounts, limits, sysctls and units.
POLICYCHECK=0
# sonora.slow=N: the guest runs under TCG emulation, N times slower than KVM.
# Scales the waits only (hand-back, first frame, recovery limit); no assertion
# changes. Set by tools/lib/qemu-accel.sh, never in the shipped command line.
SLOW=1
# Words, not lines: /proc/cmdline is one line of parameters.
# shellcheck disable=SC2013
for word in $(cat /proc/cmdline); do
  case "$word" in
    sonora.expect_capture=*) EXPECT_CAPTURE="${word#sonora.expect_capture=}" ;;
    sonora.gui) GUI=1 ;;
    sonora.virtualcard) VIRTUALCARD=1 ;;
    sonora.policycheck) POLICYCHECK=1 ;;
    sonora.expect_fallback) EXPECT_FALLBACK=1 ;;
    sonora.expect_installed) EXPECT_INSTALLED=1 ;;
    sonora.expect_file=*) EXPECT_FILE="${word#sonora.expect_file=}" ;;
    sonora.expect_sha=*) EXPECT_SHA="${word#sonora.expect_sha=}" ;;
    sonora.break_ui) BREAK_UI=1 ;;
    sonora.slow=*) SLOW="${word#sonora.slow=}" ;;
  esac
done
case "$SLOW" in '' | *[!0-9]* | 0) SLOW=1 ;; esac
if [ "$BREAK_UI" = 1 ]; then
  GUI=1
  EXPECT_FALLBACK=1
fi
# The engine runs from sonora-session, which under sonora.gui starts only
# through the fallback.
SESSION_EXPECTED=1
[ "$GUI" = 1 ] && [ "$EXPECT_FALLBACK" = 0 ] && SESSION_EXPECTED=0
FLAG=/run/sonora-display-failed

# Milliseconds since the epoch, for the recovery timings below.
now_ms() { echo $(( $(date +%s%N) / 1000000 )); }

if [ "$BREAK_UI" = 1 ]; then
  # /bin/false exits 1, which RestartPreventExitStatus=3 does not cover, so the
  # unit restarts every second until StartLimitBurst=5 trips and OnFailure=
  # starts the fallback: a repeated failure, not a single one.
  mkdir -p /run/systemd/system/sonora-ui.service.d
  printf '[Service]\nExecStart=\nExecStart=/bin/false\n' >/run/systemd/system/sonora-ui.service.d/break.conf
  systemctl daemon-reload
  systemctl restart --no-block sonora-ui.service
fi
# This unit is ordered after sonora-session, but in the fallback run the
# session starts later, from OnFailure= of a UI that first has to fail. Wait
# for the hand-back before the engine checks below sample anything.
if [ "$EXPECT_FALLBACK" = 1 ]; then
  i=0
  while [ "$i" -lt $((90 * SLOW)) ] && ! systemctl is-active --quiet sonora-session.service; do
    i=$((i + 1))
    sleep 1
  done
fi

echo "SMOKETEST begin"
[ "$SLOW" = 1 ] || echo "SMOKETEST info  slow mode x$SLOW: waits scaled, assertions unchanged"

# --- 1. nothing failed on the way up ---
# Deliberately not `is-active multi-user.target`: this unit is ordered after
# that target and pulled in by it, so that check cannot fail and is worthless.
#
# Also deliberately not `is-system-running`: it returns "starting" until every
# queued job finishes, and this unit is one of those jobs, so it can never see
# "running" from in here. That check was written, it failed the boot test for
# a healthy system, and this is the replacement.
#
# Asking for failed units directly is the real question, and answerable now.
FAILED_UNITS="$(systemctl list-units --state=failed --no-legend --plain 2>/dev/null)"
echo "SMOKETEST info  system state $(systemctl is-system-running 2>/dev/null) (this unit is itself still a running job)"
# In the fallback run the broken UI (and the compositor, if it hit its start
# limit) failing is the trigger under test, not a defect.
if [ "$EXPECT_FALLBACK" = 1 ]; then
  FAILED_UNITS="$(printf '%s
' "$FAILED_UNITS" | grep -Ev '^(sonora-ui|sonora-compositor)\.service ' || true)"
fi
if [ -z "$FAILED_UNITS" ]; then
  echo "SMOKETEST ok    no failed units"
else
  fail "units failed during boot"
  printf '%s\n' "$FAILED_UNITS" | sed 's/^/SMOKETEST info    /'
fi

# --- 2. the engine is running, and has not been restarting ---
if [ "$SESSION_EXPECTED" = 1 ]; then
i=0
while [ "$i" -lt 30 ]; do
  pgrep -x sonora-engine >/dev/null 2>&1 && break
  i=$((i + 1))
  sleep 1
done
check "sonora-engine process alive" pgrep -x sonora-engine
check "sonora-session.service active" systemctl is-active --quiet sonora-session.service

# Restart=always makes a crash loop look healthy if you only sample once.
RESTARTS="$(systemctl show -p NRestarts --value sonora-session.service 2>/dev/null)"
echo "SMOKETEST info  session restarts $RESTARTS"
if [ "$RESTARTS" = "0" ]; then
  echo "SMOKETEST ok    engine has not restarted"
else
  fail "engine restarted $RESTARTS times"
fi

# Hold still and confirm it is the same process, so a loop that restarts
# slower than the check above cannot slip through either.
PID_BEFORE="$(pgrep -x sonora-engine | head -1)"
sleep 10
PID_AFTER="$(pgrep -x sonora-engine | head -1)"
if [ -n "$PID_BEFORE" ] && [ "$PID_BEFORE" = "$PID_AFTER" ]; then
  echo "SMOKETEST ok    engine survived 10s (pid $PID_AFTER)"
else
  fail "engine pid changed: $PID_BEFORE then $PID_AFTER"
fi
else
  echo "SMOKETEST info  sonora.gui without fallback: the engine runs as sonora-engine.service (checked with the display stack)"
fi

# --- 3. the kernel is the real-time one ---
# The latency premise of the project rests on this and nothing else in the
# system would report it.
echo "SMOKETEST info  kernel $(uname -r)"
check "kernel is -rt-" sh -c 'uname -r | grep -q -- "-rt-"'

# --- supporting checks, each one a defect that already happened ---
check "libjack resolves" sh -c 'ldconfig -p | grep -q "libjack.so.0"'
check "libjack is pipewire's" sh -c 'ldconfig -p | grep "libjack.so.0" | grep -q pipewire'
check "engine is executable" test -x /usr/local/bin/sonora-engine
check "operator account exists" id sonora
check "operator is in audio group" sh -c 'id -nG sonora | grep -qw audio'
check "operator is NOT in disk group" sh -c '! id -nG sonora | grep -qw disk'
check "rt limits installed" test -f /etc/security/limits.d/95-audio.conf
# Asked of the running server, not grepped from the file: a drop-in that fails
# to parse, or a stock rule that outranks it (pipewire.conf raises min-quantum
# to 1024 under a hypervisor), would leave a file that looks right.
SETTINGS="$(su - sonora -c 'XDG_RUNTIME_DIR=/run/user/1000 pw-metadata -n settings 0' 2>/dev/null)"
setting() { printf '%s\n' "$SETTINGS" | sed -n "s/.*key:'$1' value:'\([^']*\)'.*/\1/p"; }
PW_QUANTUM="$(setting clock.quantum)/$(setting clock.min-quantum)/$(setting clock.max-quantum)"
PW_RATE="$(setting clock.rate)|$(setting clock.allowed-rates)"
echo "SMOKETEST info  pipewire quantum/min/max $PW_QUANTUM, rate|allowed $PW_RATE"
check "pipewire quantum pinned at 128" test "$PW_QUANTUM" = "128/128/128"
check "pipewire rate pinned at 48000" test "$PW_RATE" = "48000|[ 48000 ]"
check "wireplumber pro-audio rule" sh -c 'grep -q "pro-audio" /etc/wireplumber/wireplumber.conf.d/99-sonora.conf'
check "pipewire running" pgrep -x pipewire
# PipeWire was running above only because the session's PAM login started the
# user manager; without lingering it goes down with every engine restart.
check "operator lingers" sh -c 'loginctl show-user sonora -p Linger | grep -qx Linger=yes'
check "no serial login prompt" sh -c '! systemctl is-active --quiet "serial-getty@ttyS0.service"'
# Asked of logind, not grepped from the drop-in: a stock file that outranks it
# would leave Ctrl+Alt+F2 opening a passwordless login.
check "no VT login prompts" sh -c 'busctl get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager NAutoVTs | grep -qx "u 0"'

# --- 3b. a virtual multichannel card, when asked for ---
# Before section 4 so its capture_AUX count includes the card.
if [ "$VIRTUALCARD" = 1 ]; then
  echo "SMOKETEST info  sonora.virtualcard: snd-dummy rme9652"
  # shellcheck disable=SC1091
  . /usr/local/bin/sonora-virtualcard-test
fi

# --- 3c. policy of the running system, when asked for ---
if [ "$POLICYCHECK" = 1 ]; then
  echo "SMOKETEST info  sonora.policycheck: asserting the running policy"
  # shellcheck disable=SC1091
  . /usr/local/bin/sonora-policycheck
fi

# --- 4. how many capture channels the audio server really offers ---
# Counted and asserted, not just printed. A UMC1820 appearing as two channels
# instead of eighteen is precisely the failure the pro-audio rule exists to
# prevent, and it would otherwise show up as a cheerful info line.
PORTS="$(su - sonora -c 'XDG_RUNTIME_DIR=/run/user/1000 pw-link -o 2>/dev/null' 2>/dev/null)"
# capture_AUX<n> is how the Pro Audio profile names an audio channel. A bare
# "capture" match also counts "Midi Through Port-0 (capture)", inflating the
# number on any machine that has a MIDI bridge.
CAPTURE_COUNT="$(printf '%s\n' "$PORTS" | grep -c "capture_AUX" 2>/dev/null)"
echo "SMOKETEST info  capture ports: $CAPTURE_COUNT (expected at least $EXPECT_CAPTURE)"
printf '%s\n' "$PORTS" | sed 's/^/SMOKETEST info    /'
if [ "$CAPTURE_COUNT" -ge "$EXPECT_CAPTURE" ] 2>/dev/null; then
  echo "SMOKETEST ok    capture ports present"
else
  fail "only $CAPTURE_COUNT capture ports, expected $EXPECT_CAPTURE"
fi

# The Pro Audio profile shows up in the node name, which is the cheapest proof
# the wireplumber rule was actually applied rather than merely present.
if printf '%s\n' "$PORTS" | grep -q "pro-input"; then
  echo "SMOKETEST ok    pro-audio profile applied"
else
  fail "no pro-input node; the pro-audio profile was not applied"
fi

# --- 5a. display stack timings (ADR-0010 stage 1 smoke checks) ---
unit_pid() { systemctl show -p MainPID --value "$1" 2>/dev/null; }

# wait_new_pid UNIT OLD_PID LIMIT_MS: poll until UNIT is active with a main PID
# other than OLD_PID. Prints the milliseconds it took; fails on timeout.
wait_new_pid() {
  t0="$(now_ms)"
  while :; do
    p="$(unit_pid "$1")"
    if [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != "$2" ] && systemctl is-active --quiet "$1"; then
      echo $(( $(now_ms) - t0 ))
      return 0
    fi
    [ $(( $(now_ms) - t0 )) -ge "$3" ] && return 1
    sleep 0.1
  done
}

# SIGKILL the unit's main process and require it, and the UI behind it, to run
# again within RECOVER_MS. The PID has to change: a signal the unit shrugged
# off would pass an "is it active" check taken at once.
RECOVER_MS=$((3000 * SLOW))
kill_and_recover() {
  old="$(unit_pid "$1")"
  oldui="$(unit_pid sonora-ui.service)"
  if [ -z "$old" ] || [ "$old" = 0 ]; then
    fail "$2: nothing to kill, $1 has no main process"
    return
  fi
  kill -9 "$old"
  if ms="$(wait_new_pid "$1" "$old" "$RECOVER_MS")" &&
     ms_ui="$(wait_new_pid sonora-ui.service "$oldui" "$RECOVER_MS")"; then
    echo "SMOKETEST ok    $2 recovered in ${ms} ms (UI ${ms_ui} ms)"
  else
    fail "$2 did not recover within ${RECOVER_MS} ms"
  fi
  # Settle, so the next kill is not counted against this one.
  sleep 2
}

gui_checks() {
  # The UI logs one line at its first frame (ui/qt/README.md); the journal
  # holds a unit's stderr. Waited for: Qt on a software renderer can take
  # many seconds.
  i=0
  FRAME_MS=""
  while [ "$i" -lt $((60 * SLOW)) ] && [ -z "$FRAME_MS" ]; do
    FRAME_MS="$(journalctl -b -u sonora-ui.service -o cat --no-pager 2>/dev/null |
      sed -n 's/.*first frame after \([0-9][0-9]*\) ms.*/\1/p' | tail -n 1)"
    [ -n "$FRAME_MS" ] || { i=$((i + 1)); sleep 1; }
  done
  echo "SMOKETEST info  first frame after ${FRAME_MS:-never} ms of UI uptime; boot uptime $(cut -d' ' -f1 /proc/uptime) s"
  check "UI logged its first frame" test -n "$FRAME_MS"

  # The renderer labwc and Qt ended up with on a machine with no render node
  # (QEMU -vga std). Information only; ADR-0010 unverified item 3 records it.
  echo "SMOKETEST info  /dev/dri: $(find /dev/dri -maxdepth 1 -type c 2>/dev/null | tr '\n' ' ')"
  journalctl -b -u sonora-compositor.service -o cat --no-pager 2>/dev/null |
    grep -i -E 'render|gles|pixman|llvmpipe|vulkan|swrast' | head -n 8 |
    sed 's/^/SMOKETEST info  labwc: /'
  journalctl -b -u sonora-ui.service -o cat --no-pager 2>/dev/null |
    grep -i -E 'render|gles|llvmpipe|swrast|opengl' | head -n 4 |
    sed 's/^/SMOKETEST info  ui: /'

  # Stage 2: the display stack's failures must not reach the engine. Its PID
  # is the proof a take in progress would have survived.
  ENG_PID="$(unit_pid sonora-engine.service)"
  check "sonora-engine.service has a main process" test -n "$ENG_PID" -a "$ENG_PID" != 0
  kill_and_recover sonora-ui.service "kill -9 of the UI"
  kill_and_recover sonora-compositor.service "kill -9 of labwc"
  check "engine PID unchanged by the UI and labwc kills" test "$(unit_pid sonora-engine.service)" = "$ENG_PID"
  # And the engine's own restart, with the UI left running.
  UI_PID="$(unit_pid sonora-ui.service)"
  kill -9 "$ENG_PID"
  if ms="$(wait_new_pid sonora-engine.service "$ENG_PID" "$RECOVER_MS")"; then
    echo "SMOKETEST ok    kill -9 of the engine recovered in ${ms} ms"
  else
    fail "engine did not recover within ${RECOVER_MS} ms"
  fi
  check "UI PID unchanged by the engine kill" test "$(unit_pid sonora-ui.service)" = "$UI_PID"
  check "display fallback did not run after the kills" test ! -e "$FLAG"
}

# --- 5. build id and the display stack (ADR-0010) ---
# The catalog cache keys on BUILD_ID; an empty or missing one shares a cache
# across images.
BUILD_ID_SEEN="$(sed -n 's/^BUILD_ID=//p' /etc/os-release 2>/dev/null)"
echo "SMOKETEST info  BUILD_ID $BUILD_ID_SEEN"
check "os-release carries a BUILD_ID" test -n "$BUILD_ID_SEEN"

# LoadState first: on a missing unit is-active says "inactive", so every
# "skipped" check below would pass on an image that lost the unit.
for u in sonora-compositor sonora-ui sonora-engine sonora-display-fallback sonora-session; do
  check "$u.service is installed" sh -c "[ \"\$(systemctl show -p LoadState --value $u.service)\" = loaded ]"
done
if [ "$GUI" = 1 ] && [ "$EXPECT_FALLBACK" = 1 ]; then
  # ADR-0010 stage 1 recovery: a failing UI must end with the engine on tty1,
  # never with a blank console.
  echo "SMOKETEST info  sonora.gui with a broken UI; fallback expected"
  check "fallback flag $FLAG exists" test -e "$FLAG"
  check "sonora-session.service active after fallback" systemctl is-active --quiet sonora-session.service
  check "sonora-compositor.service stopped after fallback" sh -c '! systemctl is-active --quiet sonora-compositor.service'
  check "sonora-ui.service not running after fallback" sh -c '! systemctl is-active --quiet sonora-ui.service'
  echo "SMOKETEST info  foreground VT $(fgconsole 2>/dev/null)"
  # shellcheck disable=SC2016 # expanded by the inner sh
  check "tty1 is the foreground VT" sh -c '[ "$(fgconsole)" = 1 ]'
elif [ "$GUI" = 1 ]; then
  echo "SMOKETEST info  sonora.gui set; display stack expected to run"
  check "sonora-compositor.service active" systemctl is-active --quiet sonora-compositor.service
  check "sonora-ui.service active" systemctl is-active --quiet sonora-ui.service
  check "sonora-engine.service active (started before the UI)" systemctl is-active --quiet sonora-engine.service
  check "display fallback did not run" test ! -e "$FLAG"
  check "sonora-session.service not running under sonora.gui" sh -c '! systemctl is-active --quiet sonora-session.service'
  check "sonora-ui is executable" test -x /usr/local/bin/sonora-ui
  gui_checks
else
  # Default boot: the compositor must be enabled (so the flag alone turns it
  # on) yet skipped, and the session must own tty1.
  # shellcheck disable=SC2016 # expanded by the inner sh
  check "sonora-compositor.service enabled" sh -c '[ "$(systemctl is-enabled sonora-compositor.service)" = enabled ]'
  check "sonora-compositor.service skipped without sonora.gui" sh -c '! systemctl is-active --quiet sonora-compositor.service'
  check "sonora-ui.service skipped without sonora.gui" sh -c '! systemctl is-active --quiet sonora-ui.service'
fi
# Both units claim tty1, so they must never be startable together: their
# kernel-command-line conditions have to be opposites. Read from the unit text:
# systemd exposes conditions only as the Conditions= array, so
# `systemctl show -p ConditionKernelCommandLine` printed nothing and this
# check failed the first boot of a built image (2026-11-03).
check "session and compositor have opposite sonora.gui conditions" sh -c \
  'systemctl cat sonora-session.service | grep -Eq "^ConditionKernelCommandLine=\|?!sonora\.gui$" &&
   systemctl cat sonora-compositor.service | grep -Eq "^ConditionKernelCommandLine=sonora\.gui$"'

# --- 6. an installed system (ADR-0032) ---
if [ "$EXPECT_INSTALLED" = 1 ]; then
  echo "SMOKETEST info  root $(findmnt -no SOURCE,FSTYPE /)"
  check "install marker present" test -s /var/lib/sonora/installed
  check "root is a real ext4 disk, not a live overlay" sh -c 'findmnt -no FSTYPE / | grep -qx ext4'
  check "no live medium mounted" sh -c '! test -e /run/live/medium'
  check "live-boot is gone" sh -c '! dpkg -s live-boot >/dev/null 2>&1'
  check "installer screen is inert on an installed system" sh -c '! systemctl is-active --quiet sonora-installer.service'
fi
if [ -n "$EXPECT_FILE" ]; then
  GOT_SHA="$(sha256sum "$EXPECT_FILE" 2>/dev/null | cut -d' ' -f1)"
  echo "SMOKETEST info  carried file $EXPECT_FILE sha256 ${GOT_SHA:-missing}"
  check "carried-over session file matches its checksum" test -n "$GOT_SHA" -a "$GOT_SHA" = "$EXPECT_SHA"
fi

if [ "$FAILED" = "0" ]; then
  echo "SMOKETEST RESULT pass"
else
  echo "SMOKETEST RESULT fail"
fi

sync
# Non-zero on a failing verdict, so the unit's FailureAction= applies to it
# and not only to a script that crashed.
[ "$FAILED" = "0" ] || exit 1
