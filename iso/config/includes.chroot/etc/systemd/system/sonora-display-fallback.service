[Unit]
Description=Hand tty1 back to the recording session after the display stack failed
ConditionKernelCommandLine=sonora.gui
# It is started on every failure of the display units and usually skips itself
# (ExecCondition= below); a skipped start still counts toward the default limit
# of 5 in 10 s, and the start that matters, the sixth failure's, was refused.
StartLimitIntervalSec=0

# Started only by OnFailure= of the compositor and UI units.
#
# Until ADR-0010 stage 2 nothing listens on tty2, so switching there (what this
# unit used to do) left the operator on an empty console with no engine
# running. Instead it does what a boot without sonora.gui does: the flag file
# lifts sonora-session.service's sonora.gui condition, the compositor is
# stopped so tty1 is free, and the session takes tty1 with the engine and its
# terminal UI. The flag lives in /run, so the next boot tries the display again.
[Service]
Type=oneshot
# systemd runs OnFailure= on every failure, restarted or not; see the script.
ExecCondition=/usr/local/bin/sonora-display-gave-up
ExecStart=/usr/bin/touch /run/sonora-display-failed
# Stopped first and synchronously: both units want tty1, and the display
# stack's engine (sonora-engine.service) must not run beside the session's.
# A Conflicts= between them is not used: both are in the boot transaction and
# systemd then drops the session. The UI is BindsTo= the
# compositor, so it goes too; it is named in case the compositor already failed.
# The '-' matters: without it a stop that returns non-zero (a cancelled job)
# ends the oneshot here, and tty1 is left with neither the display nor the
# session. The session's Conflicts=getty@tty1 is all it needs from tty1.
ExecStart=-/usr/bin/systemctl stop sonora-compositor.service sonora-ui.service sonora-engine.service
# --no-block: the session waits up to a minute for the audio server and inputs,
# and nothing here should be held up by that.
ExecStart=/usr/bin/systemctl --no-block start sonora-session.service
# labwc leaves tty1 the active VT when it exits, but a crash part-way through a
# VT switch may not; the leading '-' keeps a failed chvt from failing the unit.
ExecStart=-/usr/bin/chvt 1
