[Unit]
Description=Sonora recording session
# The engine is a PipeWire client, so the server has to exist first. We wait on
# the socket rather than the service: the unit being active does not mean the
# socket is accepting connections yet.
After=sound.target systemd-user-sessions.service
Wants=sound.target
Conflicts=getty@tty1.service
# The default start limit (5 in 10 s) would stop a crash-looping engine for
# good and leave tty1 blank with no way back. Never give up.
StartLimitIntervalSec=0

[Service]
Type=simple
User=sonora
Group=sonora
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=tty

Environment=HOME=/home/sonora
Environment=XDG_RUNTIME_DIR=/run/user/1000
WorkingDirectory=/home/sonora

ExecStartPre=/usr/local/bin/sonora-wait-for-audio
# --wait-for-inputs matters at boot: PipeWire can be up before a USB
# interface is enumerated, and a take that starts first records a silent
# head with nothing to indicate why.
# Each session gets its own folder under the sessions root, a fresh
# "Untitled <n>" at every start, renamed by its first Save (ADR-0018 §3).
ExecStart=/usr/local/bin/sonora-engine --sessions /home/sonora/Sessions --wait-for-inputs 60

# The operator must never land on a shell. If the engine dies, bring it back.
Restart=always
RestartSec=1

# Audio threads need to outrank everything else on the machine.
LimitRTPRIO=95
LimitMEMLOCK=infinity
Nice=-10

[Install]
WantedBy=multi-user.target
