[Unit]
Description=Sonora boot smoke test
Documentation=file:///usr/local/bin/sonora-smoketest

# The shipped image must never power itself off, so this runs only when the
# kernel command line explicitly asks for it.
ConditionKernelCommandLine=sonora.smoketest

# After the session unit, so there is an engine to find. Not Requires: if the
# session failed to start, that is exactly what the test must report rather
# than a reason to skip.
After=multi-user.target sonora-session.service

# These actions are the only thing that powers the guest off; the script does
# not. TimeoutStartSec alone only kills the service -- the guest would stay
# powered on until the harness clock ran out, which costs five minutes and
# tells nobody anything.
#
# Success is an orderly poweroff: the session stops, /home's persistence
# overlay is unmounted, and tools/test-write-usb.sh boot 3 can demand a clean
# fsck afterwards. poweroff-force here skipped the unit stops and pre-empted
# the orderly poweroff the script used to queue itself.
#
# Failure, which includes the timeout, is forced: a check wedged on a stalled
# PipeWire (pw-link is the likely candidate) can wedge an orderly stop too.
#
# They are [Unit] keys: under [Service] systemd ignored SuccessAction= with a
# warning (systemd-analyze verify, tools/test-display-fallback.sh).
FailureAction=poweroff-force
SuccessAction=poweroff

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/usr/local/bin/sonora-smoketest

# The engine owns tty1, so results go to the serial console where the harness
# can read them.
StandardOutput=journal+console
StandardError=journal+console

TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
