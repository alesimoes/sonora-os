# The RT kernel is NOT listed here. It comes from --linux-flavours rt-amd64 in
# auto/config, which is what makes it the bootstrap flavour and therefore the
# kernel the default boot entry actually loads. Listing it here as well would
# pull in the generic kernel alongside it.

# Audio server. ADR-0003: PipeWire only, no jackd. pipewire-jack provides the
# API our engine links against.
pipewire
pipewire-pulse
pipewire-jack
libspa-0.2-modules
wireplumber

# Audio tooling the engine and diagnostics need.
alsa-utils

# libjack-jackd2-0 is deliberately NOT here. It installs a libjack.so.0 into
# the default library path, which wins over the one pipewire-jack ships in
# pipewire-0.3/jack/, and our engine then tries to reach a jackd that does not
# exist: "Cannot connect to server socket". The hook makes pipewire-jack the
# system-wide JACK instead.

# Firmware, so unknown hardware has a chance of working on first boot.
firmware-linux
firmware-sof-signed

# Storage for session disks.
e2fsprogs
exfatprogs
dosfstools
parted

# Minimum to run the engine on a tty with no desktop.
kbd
console-setup
util-linux

# Diagnostics. An appliance that cannot be debugged in the room is not useful.
pciutils
usbutils
htop
less
nano
