#!/bin/sh
# Runs inside the chroot after 0100. Installs yabridge from the upstream
# release tarball, pinned by SHA-256 (ADR-0017 Y1: Debian does not package it;
# GPL-3.0-or-later, recorded in brain/research/yabridge-packaging.md).
# tools/test-image-config.sh keeps these two values equal to the ones in
# tools/Dockerfile.yabridge.
set -e

SONORA_YABRIDGE_VERSION=5.1.1
SONORA_YABRIDGE_SHA256=d11f0307412b5566b09a75ed4aa191266db56d22f4de4d20e4fbde6296cd1a47
SONORA_WINE_SERIES=10.0

# The snapshot decides the Wine build; an unexpected series means the
# snapshot moved and the Y5 test has not been re-run against it.
got="$(dpkg-query -W -f='${Version}' wine64 2>/dev/null || true)"
case "$got" in
  "$SONORA_WINE_SERIES"*) ;;
  *)
    echo "E: wine64 is '$got', expected the $SONORA_WINE_SERIES series (ADR-0017 Y1)." >&2
    exit 1
    ;;
esac

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
curl -fsSL --retry 3 -o "$tmp/yabridge.tar.gz" \
  "https://github.com/robbert-vdh/yabridge/releases/download/${SONORA_YABRIDGE_VERSION}/yabridge-${SONORA_YABRIDGE_VERSION}.tar.gz"
echo "${SONORA_YABRIDGE_SHA256}  $tmp/yabridge.tar.gz" | sha256sum -c -
rm -rf /opt/yabridge
tar xzf "$tmp/yabridge.tar.gz" -C /opt

# yabridgectl looks for the plugin libraries beside itself, in
# ~/.local/share/yabridge and in /usr/lib; yabridge-host.exe has to be on PATH.
# The libraries go to /usr/lib so the search does not depend on how
# yabridgectl resolves its own path.
for lib in /opt/yabridge/libyabridge-*.so; do
  install -m 0644 "$lib" /usr/lib/
done
for bin in yabridgectl yabridge-host.exe; do
  ln -sf "/opt/yabridge/$bin" "/usr/local/bin/$bin"
done
for need in /usr/local/bin/yabridgectl /usr/local/bin/yabridge-host.exe /usr/lib/libyabridge-vst3.so; do
  if [ ! -e "$need" ]; then
    echo "E: yabridge install is missing $need." >&2
    exit 1
  fi
done
mkdir -p /usr/share/doc/yabridge
printf 'yabridge %s, GPL-3.0-or-later, https://github.com/robbert-vdh/yabridge\n' \
  "$SONORA_YABRIDGE_VERSION" > /usr/share/doc/yabridge/SONORA-PROVENANCE

chmod 0755 /usr/local/bin/sonora-windows-plugins
chmod 0644 /etc/systemd/system/sonora-windows-plugins.service
# The unit carries a ConditionPathExists on its stamp: once per account.
systemctl enable sonora-windows-plugins.service
