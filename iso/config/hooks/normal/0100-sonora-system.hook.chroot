#!/bin/sh
# Runs inside the chroot during `lb build`. Creates the operator account and
# installs the tuning that audio-stack/ documents.
set -e

# --- every package came from the one snapshot ---
# The chroot's sources are still the build-time ones while hooks run. A stale
# config/ (lb config not re-run) or a live mirror here installs whatever
# kernel deb.debian.org had that day, and the image still builds. So every
# deb line must be snapshot.debian.org at the backports list's timestamp.
ts="$(grep -Eho 'snapshot\.debian\.org/archive/debian/[0-9]{8}T[0-9]{6}Z' /etc/apt/sources.list.d/sonora-backports.list | head -n 1 | grep -Eo '[0-9]{8}T[0-9]{6}Z' || true)"
if [ -z "$ts" ]; then
  echo "E: no snapshot timestamp in /etc/apt/sources.list.d/sonora-backports.list." >&2
  exit 1
fi
off="$(cat /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null |
  grep -E '^deb ' | grep -Ev "snapshot\.debian\.org/archive/debian(-security)?/$ts/? " || true)"
# deb822 files are read by apt as well (trixie's own images ship
# debian.sources), and a one-line grep never sees their URIs: field, which may
# list several URIs and continue on indented lines. A stanza with
# "Enabled: no" is not read by apt, so it does not count.
off822="$(cat /etc/apt/sources.list.d/*.sources 2>/dev/null | awk '
  function flush() { if (!disabled) for (i = 1; i <= n; i++) print uris[i]; n = 0; disabled = 0; field = "" }
  /^#/ { next }
  /^[[:space:]]*$/ { flush(); next }
  /^[[:space:]]/ { if (field == "uris") for (i = 1; i <= NF; i++) uris[++n] = $i; next }
  { field = tolower($1) }
  field == "uris:" { field = "uris"; for (i = 2; i <= NF; i++) uris[++n] = $i; next }
  field == "enabled:" && tolower($2) == "no" { disabled = 1 }
  END { flush() }' |
  grep -Ev "^https?://snapshot\.debian\.org/archive/debian(-security)?/$ts/?$" || true)"
[ -n "$off822" ] && off="${off:+$off
}$off822"
if [ -n "$off" ]; then
  echo "E: build sources outside snapshot $ts:" >&2
  echo "$off" >&2
  exit 1
fi

# --- operator account ---
# uid 1000 is hard-coded because the systemd unit sets XDG_RUNTIME_DIR to
# /run/user/1000. If these two disagree the engine cannot reach PipeWire.
if ! id sonora >/dev/null 2>&1; then
  useradd --create-home --uid 1000 --shell /bin/bash sonora
fi
# No `disk` group: that is raw block-device access, and this account has
# no password. The engine needs write permission on its session
# directory, which is ownership, not block access.
usermod -aG audio,video,plugdev sonora
passwd -d sonora

install -d -o sonora -g sonora /home/sonora/Sessions

# --- the PipeWire the image was meant to get ---
# config/archives/sonora-backports.pref.chroot pins these. A pin whose version
# the source no longer has is ignored without a word, and apt installs
# trixie's PipeWire instead. tools/test-image-config.sh keeps these numbers
# equal to the .pref file's.
SONORA_PIPEWIRE_VERSION=1.6.9-2~bpo13+1
SONORA_WIREPLUMBER_VERSION=0.5.12-1~bpo13+1
for pkg in pipewire pipewire-jack libspa-0.2-modules; do
  got="$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null || true)"
  if [ "$got" != "$SONORA_PIPEWIRE_VERSION" ]; then
    echo "E: $pkg is '$got', expected $SONORA_PIPEWIRE_VERSION from the pinned backports snapshot." >&2
    exit 1
  fi
done
got="$(dpkg-query -W -f='${Version}' wireplumber 2>/dev/null || true)"
if [ "$got" != "$SONORA_WIREPLUMBER_VERSION" ]; then
  echo "E: wireplumber is '$got', expected $SONORA_WIREPLUMBER_VERSION." >&2
  exit 1
fi

# --- no display manager ---
# A display manager would take tty1 or tty7 with a greeter and put a login
# between the operator and the engine. None is listed, but a Recommends or a
# future package can pull one in, so check what actually got installed.
if [ -e /etc/systemd/system/display-manager.service ]; then
  echo "E: a display manager is installed: $(readlink -f /etc/systemd/system/display-manager.service)" >&2
  exit 1
fi

# --- make pipewire-jack the system-wide JACK ---
# pipewire-jack installs its libjack into pipewire-0.3/jack/ rather than the
# default library path, and ships the drop-in that fixes that as an example
# only. Without this the engine links against nothing and dies at startup with
# "Cannot connect to server socket", then the unit restarts it forever.
install -D -m 0644   /usr/share/doc/pipewire/examples/ld.so.conf.d/pipewire-jack-x86_64-linux-gnu.conf   /etc/ld.so.conf.d/pipewire-jack.conf
ldconfig

# Prove it resolved, rather than discovering it on a boot.
if ! ldconfig -p | grep -q "libjack.so.0"; then
  echo "E: libjack.so.0 does not resolve; the engine will not start." >&2
  exit 1
fi

# --- audio tuning ---
install -D -m 0644 /usr/share/sonora/limits-audio.conf \
  /etc/security/limits.d/95-audio.conf
install -D -m 0644 /usr/share/sonora/sysctl-sonora.conf \
  /etc/sysctl.d/99-sonora.conf
install -D -m 0644 /usr/share/sonora/pipewire-sonora.conf \
  /etc/pipewire/pipewire.conf.d/99-sonora.conf
# Without this a multichannel interface appears as a stereo pair and most of
# its inputs are invisible to the engine. See the file for why.
install -D -m 0644 /usr/share/sonora/wireplumber-sonora.conf \
  /etc/wireplumber/wireplumber.conf.d/99-sonora.conf

# --- executable bits ---
# includes.chroot is copied from the build host, and when that host is Windows
# the files arrive mode 644. systemd would then fail to start the engine with a
# permission error that says nothing about why. Set the modes here, where the
# filesystem actually carries them.
chmod 0755 /usr/local/bin/sonora-engine
chmod 0755 /usr/local/bin/sonora-tui
chmod 0755 /usr/local/bin/sonora-wait-for-audio
chmod 0755 /usr/local/bin/sonora-smoketest
chmod 0755 /usr/local/bin/sonora-install
chmod 0755 /usr/local/bin/sonora-install-tty
chmod 0755 /usr/local/bin/sonora-compositor
chmod 0755 /usr/local/bin/sonora-wait-for-display
chmod 0755 /usr/local/bin/sonora-engine-run
chmod 0755 /usr/share/sonora/labwc/autostart
chmod 0755 /usr/local/bin/sonora-display-gave-up
# sonora-ui is staged only when a UI build exists; the units are inert without
# sonora.gui, so its absence must not fail the build.
[ -e /usr/local/bin/sonora-ui ] && chmod 0755 /usr/local/bin/sonora-ui

# The engine must exist, or the image boots into a Restart=always loop against
# a missing file. Fail the build instead.
if [ ! -x /usr/local/bin/sonora-engine ]; then
  echo "E: sonora-engine was not staged into the image." >&2
  exit 1
fi
# Without it the engine runs headless and tty1 shows no interface.
if [ ! -x /usr/local/bin/sonora-tui ]; then
  echo "E: sonora-tui was not staged into the image." >&2
  exit 1
fi
if [ ! -x /usr/local/bin/sonora-smoketest ]; then
  echo "E: sonora-smoketest is missing; the boot test cannot run." >&2
  exit 1
fi

# --- build id ---
# The plugin catalog cache's header carries BUILD_ID (ADR-0012), so a new
# image discards stale caches once. /etc/os-release is a symlink to
# /usr/lib/os-release; write the target so the symlink survives.
BUILD_ID_FILE=/usr/share/sonora/build-id
if [ -s "$BUILD_ID_FILE" ]; then
  BUILD_ID="$(head -n 1 "$BUILD_ID_FILE" | tr -cd 'A-Za-z0-9._-')"
fi
# A file of only characters the filter strips leaves nothing; an empty
# BUILD_ID= would key every cache to the same value.
[ -n "${BUILD_ID:-}" ] || BUILD_ID=unstamped
OSREL="$(readlink -f /etc/os-release)"
sed -i '/^BUILD_ID=/d' "$OSREL"
printf 'BUILD_ID=%s\n' "$BUILD_ID" >>"$OSREL"
if ! grep -qx "BUILD_ID=$BUILD_ID" /etc/os-release; then
  echo "E: BUILD_ID did not land in /etc/os-release." >&2
  exit 1
fi

# --- services ---
# Same Windows-host modes in the other direction: the units arrive 0755 and
# systemctl warns "marked executable" for each. A unit is configuration.
chmod 0644 /etc/systemd/system/sonora-*.service
systemctl enable sonora-session.service
# Safe to enable unconditionally: the unit carries
# ConditionKernelCommandLine=sonora.smoketest, so on a shipped image it
# is inert. Without enabling it the test silently never runs, which is
# worse than not having it.
systemctl enable sonora-smoketest.service
# Same shape for the installer screen (ADR-0032): the unit carries
# ConditionKernelCommandLine=sonora.install and is inert without it.
systemctl enable sonora-installer.service
# Same for the display stack (ADR-0010): ConditionKernelCommandLine=sonora.gui
# on the compositor and UI units; sonora-session.service carries the negation.
systemctl enable sonora-compositor.service
# Inert on the live stick: ConditionKernelCommandLine=sonora.slot (ADR-0044).
systemctl enable sonora-confirm.service
# No display manager and no login prompt on tty1: the unit owns that tty.
systemctl disable getty@tty1.service || true
# systemd-getty-generator creates serial-getty@<tty> for every console= on the
# kernel command line. The operator must never reach a shell, and this account
# has no password, so mask it rather than relying on no serial port existing.
systemctl mask serial-getty@ttyS0.service || true
systemctl mask serial-getty@ttyS1.service || true
systemctl set-default multi-user.target

# PipeWire runs in the user session, which systemd will not start for a user
# who never logs in interactively. Lingering starts it at boot instead.
# `loginctl enable-linger` needs a running logind, which a chroot has not, so
# it failed on every build ("System has not been booted with systemd") behind
# an `|| true`. The flag file is all logind reads at boot; write it directly.
install -d -m 0755 /var/lib/systemd/linger
: >/var/lib/systemd/linger/sonora
