#!/bin/sh
# Runs inside the chroot during `lb build`. Creates the operator account and
# installs the tuning that audio-stack/ documents.
set -e

# --- operator account ---
# uid 1000 is hard-coded because the systemd unit sets XDG_RUNTIME_DIR to
# /run/user/1000. If these two disagree the engine cannot reach PipeWire.
if ! id sonora >/dev/null 2>&1; then
  useradd --create-home --uid 1000 --shell /bin/bash sonora
fi
# No `disk` group: that is raw block-device access, and this account has
# no password. The engine needs write permission on its session
# directory, which is ownership, not block access.
usermod -aG audio,video,plugdev sonora
passwd -d sonora

install -d -o sonora -g sonora /home/sonora/Sessions

# --- make pipewire-jack the system-wide JACK ---
# pipewire-jack installs its libjack into pipewire-0.3/jack/ rather than the
# default library path, and ships the drop-in that fixes that as an example
# only. Without this the engine links against nothing and dies at startup with
# "Cannot connect to server socket", then the unit restarts it forever.
install -D -m 0644   /usr/share/doc/pipewire/examples/ld.so.conf.d/pipewire-jack-x86_64-linux-gnu.conf   /etc/ld.so.conf.d/pipewire-jack.conf
ldconfig

# Prove it resolved, rather than discovering it on a boot.
if ! ldconfig -p | grep -q "libjack.so.0"; then
  echo "E: libjack.so.0 does not resolve; the engine will not start." >&2
  exit 1
fi

# --- audio tuning ---
install -D -m 0644 /usr/share/sonora/limits-audio.conf \
  /etc/security/limits.d/95-audio.conf
install -D -m 0644 /usr/share/sonora/sysctl-sonora.conf \
  /etc/sysctl.d/99-sonora.conf
install -D -m 0644 /usr/share/sonora/pipewire-sonora.conf \
  /etc/pipewire/pipewire.conf.d/99-sonora.conf
# Without this a multichannel interface appears as a stereo pair and most of
# its inputs are invisible to the engine. See the file for why.
install -D -m 0644 /usr/share/sonora/wireplumber-sonora.conf \
  /etc/wireplumber/wireplumber.conf.d/99-sonora.conf

# --- executable bits ---
# includes.chroot is copied from the build host, and when that host is Windows
# the files arrive mode 644. systemd would then fail to start the engine with a
# permission error that says nothing about why. Set the modes here, where the
# filesystem actually carries them.
chmod 0755 /usr/local/bin/sonora-engine
chmod 0755 /usr/local/bin/sonora-tui
chmod 0755 /usr/local/bin/sonora-wait-for-audio
chmod 0755 /usr/local/bin/sonora-smoketest

# The engine must exist, or the image boots into a Restart=always loop against
# a missing file. Fail the build instead.
if [ ! -x /usr/local/bin/sonora-engine ]; then
  echo "E: sonora-engine was not staged into the image." >&2
  exit 1
fi
# Without it the engine runs headless and tty1 shows no interface.
if [ ! -x /usr/local/bin/sonora-tui ]; then
  echo "E: sonora-tui was not staged into the image." >&2
  exit 1
fi
if [ ! -x /usr/local/bin/sonora-smoketest ]; then
  echo "E: sonora-smoketest is missing; the boot test cannot run." >&2
  exit 1
fi

# --- build id ---
# The plugin catalog cache's header carries BUILD_ID (ADR-0012), so a new
# image discards stale caches once. /etc/os-release is a symlink to
# /usr/lib/os-release; write the target so the symlink survives.
BUILD_ID_FILE=/usr/share/sonora/build-id
if [ -s "$BUILD_ID_FILE" ]; then
  BUILD_ID="$(head -n 1 "$BUILD_ID_FILE" | tr -cd 'A-Za-z0-9._-')"
else
  BUILD_ID=unstamped
fi
OSREL="$(readlink -f /etc/os-release)"
sed -i '/^BUILD_ID=/d' "$OSREL"
printf 'BUILD_ID=%s\n' "$BUILD_ID" >>"$OSREL"
if ! grep -qx "BUILD_ID=$BUILD_ID" /etc/os-release; then
  echo "E: BUILD_ID did not land in /etc/os-release." >&2
  exit 1
fi

# --- services ---
systemctl enable sonora-session.service
# Safe to enable unconditionally: the unit carries
# ConditionKernelCommandLine=sonora.smoketest, so on a shipped image it
# is inert. Without enabling it the test silently never runs, which is
# worse than not having it.
systemctl enable sonora-smoketest.service
# No display manager and no login prompt on tty1: the unit owns that tty.
systemctl disable getty@tty1.service || true
# systemd-getty-generator creates serial-getty@<tty> for every console= on the
# kernel command line. The operator must never reach a shell, and this account
# has no password, so mask it rather than relying on no serial port existing.
systemctl mask serial-getty@ttyS0.service || true
systemctl mask serial-getty@ttyS1.service || true
systemctl set-default multi-user.target

# PipeWire runs in the user session, which systemd will not start for a user
# who never logs in interactively. Lingering starts it at boot instead.
loginctl enable-linger sonora || true
