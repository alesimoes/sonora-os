# Everything in this repository is consumed by Linux. A CRLF line ending in a
# shell script makes the kernel look for an interpreter named "/bin/sh\r",
# which fails with a confusing "no such file or directory", so line endings are
# forced to LF regardless of the checkout platform.
* text=auto eol=lf

*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.list    text eol=lf
*.hook    text eol=lf
*.chroot  text eol=lf
*.cpp     text eol=lf
*.h       text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf

# Windows launchers: cmd.exe misparses labels and multi-line blocks with LF.
*.cmd     text eol=crlf
*.ps1     text eol=crlf

*.iso  binary
*.wav  binary
*.msq  binary
