# Third-party readers for tools/test-bwf-interop.sh.
#
# Kept apart from the runtime image on purpose: Ardour's dependencies pull in
# libjack-jackd2-0 (checked 2026-10-12 on trixie, via libfluidsynth3), which is
# exactly the library Dockerfile.runtime keeps out because it shadows
# pipewire-jack. Recording happens in the image we ship; judging happens here.
#
# Every reader is Debian trixie's own package. Versions are printed by the
# test, so a verdict always names the reader that gave it.
FROM debian:trixie

RUN ok=; A="-o Acquire::Retries=5 -o Acquire::http::Timeout=30"; \
 for d in 0 15 45; do [ "$d" = 0 ] || sleep "$d"; \
 if apt-get $A update && apt-get $A install -y --no-install-recommends \
      ardour \
      ffmpeg \
      mediainfo \
      python3 \
      sndfile-programs \
      sox \
    ; then ok=1; break; fi; echo "apt attempt $d failed" >&2; done; \
    [ -n "$ok" ] || { echo "apt-get update/install failed after 3 attempts (mirror unreachable?)" >&2; exit 1; }; \
    rm -rf /var/lib/apt/lists/*

# Readers have no reason to be root, and Ardour writes its config under $HOME.
RUN useradd --create-home --uid 1000 reader
USER reader
WORKDIR /home/reader
