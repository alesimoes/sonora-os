{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {"type": "command", "command": "python \"{{TOOLS_DIR}}/harness.py\" inbox --brief --hook"}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python \"{{TOOLS_DIR}}/harness.py\" check --hook"}
        ]
      }
    ]
  }
}
