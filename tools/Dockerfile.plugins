# Build and test the plugin host (plugins/host) against real LV2 plugins, and
# validate Sonora's own plugin bundles (plugins/native, ADR-0011 N1).
#
# The engine's toolchain (Dockerfile.build) plus lilv and three small,
# well-known plugin packages from Debian trixie main:
#   lv2-examples     eg-amp, the LV2 reference gain plugin (ISC)
#   x42-plugins      x42-dpl, a look-ahead peak limiter that reports latency (GPL-2+)
#   lsp-plugins-lv2  the LSP limiter, a second latency-reporting plugin (LGPL-3+)
# lilv-utils is for a person poking at the image (lv2ls, lv2info), not the tests.
#
# VST3, also Debian trixie main (licences: brain/research/plugin-host-vst3.md):
#   libvst3sdk-dev     Steinberg's VST3 SDK headers, 3.7.10, used under GPL-3
#   vst3sdk-plugins    the SDK's sample plugins; AGain is the gain test (BSD-3-clause)
#   lsp-plugins-vst3   the LSP limiter as VST3, the latency test (LGPL-3+)
#
# Two validators, built in the first stage because Debian packages neither
# (ADR-0011 §1.2, the N1 checkpoint). They are test tools: they run here and
# never ship in the ISO.
#   lv2lint 0.16.2       Hanspeter Portner, Artistic-2.0, git.ventosus.ch
#   validator (VST3)     Steinberg's VST3 SDK v3.8.1_build_84, MIT since 3.8
#                        (ADR-0011, Unverified 1, settled 2026-10-13)
#
# The SPICE references of the analog models (ADR-0011 §3.3, N2), also
# Debian trixie main:
#   ngspice            the circuit simulator (BSD-3-Clause, parts under other
#                      free licences: /usr/share/doc/ngspice/copyright).
#                      sonora-dsp-measure --spice drives it in batch mode to
#                      re-derive the committed references from their netlists
#                      (ctest spice_*). A test tool, like the validators.
#
# Plugin editors (plugins/host src/editor.h), also Debian trixie main:
#   libx11-dev    Xlib, which the host's editor windows are made with (MIT)
#   xvfb, xauth   a private X server for the editor tests (xvfb-run; MIT)
#
# The stock effects set (ADR-0076, plugins/content/stock.json): dragonfly-reverb-lv2,
# zam-plugins and invada-studio-plugins-lv2 beside lsp-plugins-lv2 above, the
# packages of iso/config/package-lists/sonora-stock.list.chroot, so
# test_stock_probe sees them. tools/check-stock.sh keeps the lists equal.
#
# Nothing here ships in the ISO. Which plugins the appliance carries is a
# separate decision.
FROM debian:trixie-slim AS validators

RUN ok=; A="-o Acquire::Retries=5 -o Acquire::http::Timeout=30"; \
 for d in 0 15 45; do [ "$d" = 0 ] || sleep "$d"; \
 if apt-get $A update && apt-get $A install -y --no-install-recommends \
      build-essential \
      cmake \
      git \
      ca-certificates \
      pkg-config \
      meson \
      ninja-build \
      liblilv-dev \
      lv2-dev \
      libelf-dev \
    ; then ok=1; break; fi; echo "apt attempt $d failed" >&2; done; \
    [ -n "$ok" ] || { echo "apt-get update/install failed after 3 attempts (mirror unreachable?)" >&2; exit 1; }; \
    rm -rf /var/lib/apt/lists/*

# lv2lint, with its symbol-visibility (ELF) checks: a bundle that exports
# more than the LV2 entry point is a finding.
RUN git clone --depth 1 -b 0.16.2 https://git.ventosus.ch/lv2lint/ /tmp/lv2lint \
    && cd /tmp/lv2lint \
    && meson setup build --prefix=/opt/validators -Delf-tests=enabled \
    && ninja -C build install \
    && rm -rf /tmp/lv2lint

# Only the four submodules the validator needs; VSTGUI, the docs and the
# samples are left out. The validator builds with the hosting examples
# switched off: that switch also adds the editor host, which wants X11.
RUN git clone --depth 1 -b v3.8.1_build_84 https://github.com/steinbergmedia/vst3sdk.git /tmp/vst3sdk \
    && cd /tmp/vst3sdk \
    && git submodule update --init --depth 1 base cmake pluginterfaces public.sdk \
    && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
         -DSMTG_ENABLE_VSTGUI_SUPPORT=OFF -DSMTG_ENABLE_VST3_PLUGIN_EXAMPLES=OFF \
         -DSMTG_ENABLE_VST3_HOSTING_EXAMPLES=OFF -DSMTG_CREATE_PLUGIN_LINK=OFF \
         -DSMTG_RUN_VST_VALIDATOR=OFF >/dev/null \
    && cmake --build build --target validator -j"$(nproc)" \
    && install -D build/bin/Release/validator /opt/validators/bin/validator \
    && rm -rf /tmp/vst3sdk

FROM debian:trixie-slim

LABEL org.sonora=1

RUN ok=; A="-o Acquire::Retries=5 -o Acquire::http::Timeout=30"; \
 for d in 0 15 45; do [ "$d" = 0 ] || sleep "$d"; \
 if apt-get $A update && apt-get $A install -y --no-install-recommends \
      build-essential \
      cmake \
      pkg-config \
      libjack-jackd2-dev \
      ca-certificates \
      liblilv-dev \
      lv2-dev \
      lilv-utils \
      ngspice \
      lv2-examples \
      x42-plugins \
      lsp-plugins-lv2 \
      dragonfly-reverb-lv2 \
      zam-plugins \
      invada-studio-plugins-lv2 \
      libvst3sdk-dev \
      vst3sdk-plugins \
      lsp-plugins-vst3 \
      libelf1t64 \
      libx11-dev \
      xvfb \
      xauth \
    ; then ok=1; break; fi; echo "apt attempt $d failed" >&2; done; \
    [ -n "$ok" ] || { echo "apt-get update/install failed after 3 attempts (mirror unreachable?)" >&2; exit 1; }; \
    rm -rf /var/lib/apt/lists/*

COPY --from=validators /opt/validators /opt/validators
ENV PATH="/opt/validators/bin:${PATH}"

CMD ["bash"]
