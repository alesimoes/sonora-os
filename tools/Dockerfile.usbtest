# Environment for tools/test-write-usb.sh. Must run privileged: the test
# attaches a disk image file as a loop device and partitions it.
#
# It carries exactly what tools/write-usb.sh calls, plus qemu-img to hand the
# written image to QEMU and strace to check which syscalls the writer issues
# on the device. A dependency the script grows without this file growing then
# fails the test rather than a user.
FROM debian:trixie

RUN ok=; A="-o Acquire::Retries=5 -o Acquire::http::Timeout=30"; \
 for d in 0 15 45; do [ "$d" = 0 ] || sleep "$d"; \
 if apt-get $A update && apt-get $A install -y --no-install-recommends \
      util-linux \
      fdisk \
      e2fsprogs \
      coreutils \
      qemu-utils \
      perl-base \
      strace \
    ; then ok=1; break; fi; echo "apt attempt $d failed" >&2; done; \
    [ -n "$ok" ] || { echo "apt-get update/install failed after 3 attempts (mirror unreachable?)" >&2; exit 1; }; \
    rm -rf /var/lib/apt/lists/*

CMD ["bash"]
