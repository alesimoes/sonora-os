# Toolchain for building the engine and its tests. de_DE is generated so the
# comma-decimal regression tests (common/json, ui/keymap) run instead of
# skipping. python3 runs tools/failed-take-quit.py against the binaries the
# engine job has just built, on a pty in the same container. librubberband (GPL-2.0-or-later, compatible
# with our GPL-3.0-or-later: ADR-0136 sec. 3, ADR-0143 sec. 4) turns on the pitch
and elastic adapters so pitch_rubberband and elastic_rubberband build and run.
FROM debian:trixie-slim

RUN ok=; A="-o Acquire::Retries=5 -o Acquire::http::Timeout=30"; \
 for d in 0 15 45; do [ "$d" = 0 ] || sleep "$d"; \
 if apt-get $A update && apt-get $A install -y --no-install-recommends \
      build-essential \
      ccache \
      mold \
      ninja-build \
      cmake \
      pkg-config \
      libjack-jackd2-dev \
      libasound2-dev \
      ca-certificates \
      locales \
      python3 \
    ; then ok=1; break; fi; echo "apt attempt $d failed" >&2; done; \
    [ -n "$ok" ] || { echo "apt-get update/install failed after 3 attempts (mirror unreachable?)" >&2; exit 1; }; \
    rm -rf /var/lib/apt/lists/* \
    && sed -i 's/^# *de_DE.UTF-8 UTF-8/de_DE.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen

CMD ["bash"]
