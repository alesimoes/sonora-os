# Toolchain for building the engine and its tests. de_DE is generated so the
# comma-decimal regression tests (common/json, ui/keymap) run instead of
# skipping. python3 runs tools/failed-take-quit.py against the binaries the
# engine job has just built, on a pty in the same container.
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ccache \
      cmake \
      pkg-config \
      libjack-jackd2-dev \
      libasound2-dev \
      ca-certificates \
      locales \
      python3 \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's/^# *de_DE.UTF-8 UTF-8/de_DE.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen

CMD ["bash"]
